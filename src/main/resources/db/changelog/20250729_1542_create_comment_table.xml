<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="20250729_1540_create_comment_table" author="Novikov Artyom">
        <createTable tableName="comment">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_comment_users"
                             referencedTableName="users" referencedColumnNames="id" />
            </column>
            <column name="comment" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="article_id" type="UUID">
                <constraints nullable="true" foreignKeyName="fk_comment_article"
                             referencedTableName="article" referencedColumnNames="id" />
            </column>
            <column name="video_id" type="UUID">
                <constraints nullable="true" foreignKeyName="fk_comment_video"
                             referencedTableName="video" referencedColumnNames="id" />
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>