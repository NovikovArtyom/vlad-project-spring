<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="20250730_1110_create_role_table" author="Novikov Artyom">
        <createTable tableName="role">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(25)">
                <constraints nullable="false" />
            </column>
            <column name="description" type="VARCHAR(255)" />
        </createTable>
    </changeSet>

    <changeSet id="20250730_1110_filling_role_table" author="Novikov Artyom">
        <insert tableName="role">
            <column name="title" value="USER" />
            <column name="description" value="Пользователь с правами на просмотр" />
        </insert>
        <insert tableName="role">
            <column name="title" value="ADMIN" />
            <column name="description" value="Пользователь с правами на редактирование и удаление" />
        </insert>
    </changeSet>

</databaseChangeLog>